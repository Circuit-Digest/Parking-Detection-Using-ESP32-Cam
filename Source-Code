    "function reloadStream(){"
    "  retries++;"
    "  var delay=Math.min(500*retries,5000);"
    "  var img=document.getElementById('s');"
    "  setTimeout(function(){img.src='/stream?t='+Date.now();},delay);"
    "}"
    "</script>"
    "</head><body>"
